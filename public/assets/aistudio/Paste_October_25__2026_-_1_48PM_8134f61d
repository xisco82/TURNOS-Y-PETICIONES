rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Connection testing & Employee test markers (Javi, Aliz, Josep, Xisco, etc.)
    match /test/connection {
      allow read, write: if true;
    }

    match /connection_tests/{testId=**} {
      allow read, write: if true;
    }

    // Users collection (Censo oficial de empleados y administradores)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Admins lookup
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Weekly Schedules (Cuadrantes semanales publicados y borradores)
    match /schedules/{scheduleId} {
      allow read, write: if true;
    }

    // Requests (shift changes, days off, absences)
    match /requests/{requestId} {
      allow read, write: if true;
    }

    // Incidents
    match /incidents/{incidentId} {
      allow read, write: if true;
    }

    // Audit logs (immutable trail)
    match /audit_logs/{logId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // App Settings
    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}






