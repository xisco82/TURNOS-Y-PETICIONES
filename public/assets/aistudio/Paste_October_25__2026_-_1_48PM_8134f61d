import { APP_BRAND } from '../constants/branding';

interface LogoViewerModalProps {
  isOpen: boolean;
  onClose: () => void;
}

export const LogoViewerModal: React.FC<LogoViewerModalProps> = ({ isOpen, onClose }) => {
  const [rotation, setRotation] = useState(0);
