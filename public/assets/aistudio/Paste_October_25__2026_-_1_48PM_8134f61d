app.post('/api/schedules/draft', authMiddleware, adminOnly, (req: AuthRequest, res) => {
  const { weekStartDate, weekEndDate, weekLabel, rows, rawInputText, id } = req.body;

  let schedule = id ? db.schedules.find(s => s.id === id) : null;

  if (schedule) {
