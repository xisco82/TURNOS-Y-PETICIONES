  } else {
    schedule = {
      id: `sch-${Date.now()}`,
      weekStartDate,
      weekEndDate,
      weekLabel,
      status: 'draft',
      version: 1,
      rows,
      rawInputText,
      createdAt: new Date().toISOString(),
      updatedAt: new Date().toISOString(),
    };
    db.schedules.push(schedule);
  }

  saveDatabase();
  addAuditLog(
    req.user!.id,
    req.user!.name,
    `Guardó borrador de cuadrante: ${schedule.weekLabel}`,
    'cuadrante',
    undefined,
    `Borrador v${schedule.version}`
