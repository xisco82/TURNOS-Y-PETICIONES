            <span className="text-xs font-normal text-slate-400 ml-1">días</span>
          </div>
        </div>

        <div className="bg-white dark:bg-slate-900 rounded-2xl p-3 sm:p-4 border border-slate-200 dark:border-slate-800 shadow-xs">
