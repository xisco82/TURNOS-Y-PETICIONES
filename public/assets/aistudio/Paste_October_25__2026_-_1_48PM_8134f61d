                        </div>
                      ) : shift.hours > 0 ? (
                        <div className="text-xs text-slate-500 dark:text-slate-400 mt-1 flex items-center gap-1">
                          <Clock className="w-3.5 h-3.5 text-slate-400" />
                          <span>
                            {shift.hours} horas
                            {shift.rawText.toUpperCase() === 'M' && ' (Mañana)'}
                            {shift.rawText.toUpperCase() === 'T' && ' (Tarde)'}
