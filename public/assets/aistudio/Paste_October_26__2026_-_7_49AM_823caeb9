    e.preventDefault();
    if (!email.trim() || !password.trim()) {
      setErrorMsg('Por favor introduce tu correo y contraseña');
      return;
    }
    setErrorMsg(null);
    setLoading(true);

    try {
      await login(email.trim(), password.trim());
