                      } else if (code === 'V' || shift?.type === 'vacation') {
                        badgeColor = 'bg-emerald-50 text-emerald-800 dark:bg-emerald-950/70 dark:text-emerald-200 border border-emerald-200/80 dark:border-emerald-800';
                      } else if (shift?.type === 'holiday') {
